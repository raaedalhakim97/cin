# Copy to mobile/.env and fill in from your Supabase project settings.
# EXPO_PUBLIC_* vars are inlined into the app bundle at build time — same
# exposure model as the web app's VITE_* vars. The anon key is designed to be
# public and is protected by RLS, not secrecy. Never put a service-role key here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
