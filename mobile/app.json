{
  "expo": {
    "name": "BYOND HR",
    "slug": "byond-hr",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "byondhr",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "fallbackToCacheTimeout": 3000,
      "checkAutomatically": "ON_LOAD",
      "url": "https://u.expo.dev/5a43b21f-90a7-4f91-85f6-480d1fea41bf"
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "backgroundColor": "#0F0F0F",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.byond.hr",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "BYOND HR records your location when you clock in or out, so your attendance can be verified against your work site."
      }
    },
    "android": {
      "package": "com.byond.hr",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#0F0F0F"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "BYOND HR records your location when you clock in or out, so your attendance can be verified against your work site."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5a43b21f-90a7-4f91-85f6-480d1fea41bf"
      }
    },
    "owner": "byondhr"
  }
}
