# Web app configuration. Copy to `.env` and fill in real values.
#
# Both of these are PUBLIC — they ship inside the JavaScript bundle and anyone
# can read them from the browser. That is by design: the anon/publishable key
# carries no authority of its own. Every table is protected by row-level
# security, and as of the least_privilege_table_grants migration the anon role
# holds exactly one table privilege (INSERT on demo_requests) and nothing else.
#
# NEVER put the service_role key or the database password in this file. Those
# bypass RLS entirely. If either has ever been pasted into frontend code or a
# client-side env var, rotate it in the Supabase dashboard immediately.

# https://<project-ref>.supabase.co
VITE_SUPABASE_URL=

# The publishable key (sb_publishable_...) or the legacy anon key.
# Supabase dashboard -> Project Settings -> API keys.
VITE_SUPABASE_ANON_KEY=
